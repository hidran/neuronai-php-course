{
    "name": "neuron-course/plain-php",
    "description": "Plain PHP examples of the course Agentic AI in PHP with NeuronAI",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "neuron-core/neuron-ai": "^4.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Evaluators\\": "evaluators/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
