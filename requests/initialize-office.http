### Inspect the controlled MCP initialization
# @name inspectOfficeInitialization
POST http://127.0.0.1:48392/mcp
Accept: application/json, text/event-stream
Content-Type: application/json

{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "initialize",
  "params": {
    "protocolVersion": "2025-11-25",
    "capabilities": {},
    "clientInfo": {"name": "lesson-inspection", "version": "1.0.0"}
  }
}

> {%
client.test("MCP initialization returned structured data", function () {
    client.assert(response.status === 200, "Initialization failed");
    client.assert(response.body.result.serverInfo !== undefined,
        "Expected protocol server information");
});
%}
