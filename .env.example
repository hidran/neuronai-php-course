# Copy to .env and fill in the keys you have: cp .env.example .env
# .env is never committed.

# anthropic | openai | gemini | ollama
NEURON_PROVIDER=ollama

ANTHROPIC_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

OPENAI_KEY=
OPENAI_MODEL=gpt-5.5

GEMINI_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Local models: no cost. Without Docker this is your native Ollama;
# inside Docker the compose file points to host.docker.internal instead.
OLLAMA_URL=http://localhost:11434/api
OLLAMA_MODEL=qwen2.5:7b

# Embeddings (RAG lessons): openai | gemini | ollama, the model and its dimensions
EMBEDDINGS_PROVIDER=ollama
EMBEDDINGS_MODEL=nomic-embed-text
EMBEDDINGS_DIMENSIONS=
# Vector store (RAG lessons): memory | file
VECTOR_STORE=file
VECTOR_STORE_PATH=storage/vectors
VECTOR_STORE_TOP_K=4

# MariaDB 11.7+ (database lessons). Without Docker point these at your own server.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=neuron
DB_USERNAME=root
DB_ROOT_PASSWORD=secret
RAG_DSN=mysql:host=127.0.0.1;port=3306;dbname=neuron

# Redis (optional)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Optional: tracing via inspector.dev
INSPECTOR_INGESTION_KEY=

# Conversation storage (memory lessons): memory | file | sqlite
CHAT_STORE=file
CHAT_STORE_PATH=storage
# PDO connection for the sqlite store and the database lessons
DB_DSN=sqlite:storage/chat.sqlite
DB_USER=
DB_PASSWORD=
